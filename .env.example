# Template for local test/debug credentials. Copy to .env and fill in values.
# .env is gitignored; .env.example is committed as documentation.
#
# These env vars are used for ad-hoc curl / wrangler invocations from inside
# this repo during debugging. They are NOT used by the deployed worker —
# the worker's credentials live in D1 (workspace_credentials) and wrangler-
# bound secrets.

# ─── Per-workspace test credentials ─────────────────────────────────────────
# Cloudflare account-scoped API token with at minimum:
#   • AI Gateway Read + Write — for management calls (provisioning, etc.)
#   • AI Gateway Run         — for runtime dispatch via the gateway endpoint
# The Run permission is separate from Read/Write/Edit. Tokens issued via the
# "Edit AI Gateway" template often do NOT include Run by default — add it
# explicitly. Without Run, runtime calls return code 2005 "Failed to get
# response from provider" (misleading; the actual cause is missing scope).
#
# Generate at: https://dash.cloudflare.com/profile/api-tokens
CURALISTO_CF_TOKEN=

# Cloudflare AI Gateway runtime token (CF_AIG_TOKEN). Optional — if the
# gateway has authentication: true AND you want a separate token from the
# main CF API token, generate this at:
#   dash.cloudflare.com → AI Gateway → <your-gateway> → Authentication →
#   "Create authentication token"
# Either CURALISTO_CF_TOKEN (with Run perm) OR CURALISTO_AIG_TOKEN works
# for runtime gateway calls; CF accepts either header pattern.
CURALISTO_AIG_TOKEN=

# Account + gateway identifiers — not secret.
CURALISTO_ACCOUNT_ID=1b166acfd7e5422fbc534b03c977d5d1
CURALISTO_GATEWAY_NAME=curalisto-ai
