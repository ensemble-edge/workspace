{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "paths": {
      "@ensemble-edge/ui": ["../ui/dist/index.d.ts"],
      "@ensemble-edge/ui/*": ["../ui/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
