{
  "name": "@ensemble-edge/guest-runtime",
  "version": "0.1.51",
  "description": "Browser-side runtime for Ensemble guest apps — serves React, workspace UI, and layout primitives so guest workers ship as tiny bundles",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./assets": "./dist/assets.js"
  },
  "scripts": {
    "build:runtime": "node build.js",
    "build:runtime:prod": "node build.js --prod",
    "build": "node build.js --prod",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@ensemble-edge/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.27.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT"
}
