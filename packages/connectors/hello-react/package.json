{
  "name": "@ensemble-edge/connector-hello-react",
  "version": "0.1.0",
  "description": "Reference guest app — uses the workspace-served Ensemble runtime; ships ~5KB",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "node build.js",
    "predeploy": "pnpm run build",
    "dev": "pnpm run build && wrangler dev --local --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensemble-edge/guest": "workspace:*",
    "@ensemble-edge/guest-cloudflare": "workspace:*",
    "@ensemble-edge/guest-runtime": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "@ensemble-edge/ui": "workspace:*",
    "@tailwindcss/cli": "^4.2.2",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.80.0"
  }
}
