{
  "name": "@ensemble-edge/connector-hello-react",
  "version": "0.1.0",
  "description": "Reference guest app — React + workspace UI components, pixel-native to the shell",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build:js": "esbuild src/app.tsx --bundle --platform=browser --format=esm --outfile=dist/app.bundle.js --minify --tree-shaking=true --jsx=automatic",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/app.bundle.css --minify",
    "build": "pnpm run build:js && pnpm run build:css",
    "predeploy": "pnpm run build",
    "dev": "pnpm run build && wrangler dev --local --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ensemble-edge/guest": "workspace:*",
    "@ensemble-edge/guest-cloudflare": "workspace:*",
    "@ensemble-edge/ui": "workspace:*",
    "hono": "^4.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "@tailwindcss/cli": "^4.2.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.80.0"
  }
}
