{
  "name": "@ensemble-edge/workspace",
  "version": "0.1.4",
  "description": "Ensemble Workspace — shell, gateway, services, and UI for building team-collaboration platforms on Cloudflare",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ensemble-edge/workspace.git"
  },
  "homepage": "https://github.com/ensemble-edge/workspace#readme",
  "workspaces": [
    "packages/*",
    "packages/guest/*",
    "demos/*"
  ],
  "exports": {
    "./core": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js"
    },
    "./core/types": {
      "types": "./packages/core/dist/types.d.ts",
      "import": "./packages/core/dist/types.js"
    },
    "./core/mode": {
      "types": "./packages/core/dist/mode/index.d.ts",
      "import": "./packages/core/dist/mode/index.js"
    },
    "./core/mode/define-config": {
      "types": "./packages/core/dist/mode/define-config.d.ts",
      "import": "./packages/core/dist/mode/define-config.js"
    },
    "./core/services/auth": {
      "types": "./packages/core/dist/services/auth.d.ts",
      "import": "./packages/core/dist/services/auth.js"
    },
    "./core/utils/jwt": {
      "types": "./packages/core/dist/utils/jwt.d.ts",
      "import": "./packages/core/dist/utils/jwt.js"
    },
    "./core/utils/password": {
      "types": "./packages/core/dist/utils/password.d.ts",
      "import": "./packages/core/dist/utils/password.js"
    },
    "./core/utils/cookies": {
      "types": "./packages/core/dist/utils/cookies.d.ts",
      "import": "./packages/core/dist/utils/cookies.js"
    },
    "./core/middleware/auth": {
      "types": "./packages/core/dist/middleware/auth.d.ts",
      "import": "./packages/core/dist/middleware/auth.js"
    },
    "./core/middleware/cloud-auth": {
      "types": "./packages/core/dist/middleware/cloud-auth.d.ts",
      "import": "./packages/core/dist/middleware/cloud-auth.js"
    },
    "./core/routes/auth": {
      "types": "./packages/core/dist/routes/auth.d.ts",
      "import": "./packages/core/dist/routes/auth.js"
    },
    "./auth": {
      "types": "./packages/auth/dist/index.d.ts",
      "import": "./packages/auth/dist/index.js"
    },
    "./ui": {
      "types": "./packages/ui/dist/index.d.ts",
      "import": "./packages/ui/dist/index.js"
    },
    "./ui/globals.css": "./packages/ui/src/globals.css",
    "./ui/tailwind.config": "./packages/ui/tailwind.config.ts",
    "./shell": "./packages/shell/dist/shell.js",
    "./shell/assets": {
      "types": "./packages/shell/dist/assets.d.ts",
      "import": "./packages/shell/dist/assets.js"
    },
    "./shell/dist/shell.css": "./packages/shell/dist/shell.css",
    "./sdk": {
      "types": "./packages/sdk/dist/index.d.ts",
      "import": "./packages/sdk/dist/index.js"
    },
    "./guest": {
      "types": "./packages/guest/core/dist/index.d.ts",
      "import": "./packages/guest/core/dist/index.js"
    },
    "./guest/cloudflare": {
      "types": "./packages/guest/cloudflare/dist/index.d.ts",
      "import": "./packages/guest/cloudflare/dist/index.js"
    }
  },
  "files": [
    "packages/core/dist",
    "packages/core/README.md",
    "packages/auth/dist",
    "packages/auth/README.md",
    "packages/ui/dist",
    "packages/ui/src/globals.css",
    "packages/ui/tailwind.config.ts",
    "packages/ui/README.md",
    "packages/shell/dist",
    "packages/shell/README.md",
    "packages/sdk/dist",
    "packages/sdk/README.md",
    "packages/guest/core/dist",
    "packages/guest/core/README.md",
    "packages/guest/cloudflare/dist",
    "packages/guest/cloudflare/README.md",
    "scripts/create-guest-app.mjs",
    "templates/guest-react/**",
    "RELEASING.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "turbo run dev",
    "dev:demo": "npm run dev --workspace=ensemble-demo",
    "build": "node scripts/build-all.mjs",
    "build:packages": "pnpm --filter './packages/**' --filter '!@ensemble-edge/cli' run build",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "tsc --build",
    "lint": "oxlint --deny=correctness --deny=perf",
    "lint:quick": "oxlint --fix",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "changeset": "changeset"
  },
  "dependencies": {
    "@preact/signals-react": "^2.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.6",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "hono": "^4.0.0",
    "jose": "^5.0.0",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.6",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@cloudflare/workers-types": "^4.20240117.0",
    "@playwright/test": "^1.42.0",
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.27.4",
    "knip": "^6.3.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2",
    "wrangler": "^4.80.0"
  }
}
